{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/pre-commit-structure.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\pre-commit-structure.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking Productivity plugin structure"
          }
        ]
      }
    ]
  }
}
